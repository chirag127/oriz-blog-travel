---
/**
 * PostCard — "Field Log" dispatch entry (travel archetype).
 *
 * A boarding-pass row: vertical kicker with a destination tick, serif
 * headline, dek, and a mono meta foot. A faint corner perforation mark
 * (::before pseudo) echoes the coupon aesthetic from the homepage rail.
 * The dispatch number appears as a corner tag so the list reads like a
 * logbook ledger.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
  index?: number
}

const { post, index } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)
const dispatchNo = typeof index === 'number' ? String(index + 1).padStart(3, '0') : undefined
---

<article class="post-card" data-vertical={vert}>
  {dispatchNo && <span class="post-card-no mono" aria-hidden="true">{dispatchNo}</span>}
  <a class="post-card-link" href={href}>
    <span class="post-card-kicker">
      <span class="post-card-tick" aria-hidden="true"></span>
      <span class="post-card-desk">{verticalLabel(vert)}</span>
      <span class="post-card-cat">{category}</span>
    </span>
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-desc">{description}</p>
    <span class="post-card-foot">
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {readingTime && <span class="post-card-rt">{readingTime}</span>}
    </span>
  </a>
  <a class="post-card-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .post-card {
    position: relative;
    border-top: 1px solid var(--rule);
    --v: var(--v-personal);
  }
  .post-card[data-vertical='dev'] { --v: var(--v-dev); }
  .post-card[data-vertical='finance'] { --v: var(--v-finance); }
  .post-card[data-vertical='culture'] { --v: var(--v-culture); }
  .post-card[data-vertical='health'] { --v: var(--v-health); }

  /* dispatch number tag — top-right corner, rotated mono stamp */
  .post-card-no {
    position: absolute;
    top: 1.125rem;
    right: 0;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    opacity: 0.45;
    user-select: none;
  }

  .post-card-link {
    display: grid;
    gap: 0.5rem;
    padding: 1.125rem 2.5rem 1.25rem 0.875rem;
    text-decoration: none;
    color: var(--ink);
    border-left: 2px solid transparent;
    margin-left: -0.875rem;
    padding-left: 0.875rem;
    transition: border-color var(--dur-fast, 120ms) ease;
  }
  .post-card-link:hover { border-left-color: var(--v); }

  .post-card-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .post-card-tick {
    width: 7px;
    height: 7px;
    background: var(--v);
    flex: 0 0 auto;
    /* diamond waypoint shape instead of square */
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  .post-card-desk { color: var(--v); font-weight: 500; }
  .post-card-cat {
    color: var(--ink-mute);
    border-left: 1px solid var(--rule);
    padding-left: 0.5rem;
    letter-spacing: 0.1em;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
    color: var(--ink);
  }
  .post-card-link:hover .post-card-title { color: var(--accent); }

  .post-card-desc {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    max-width: 62ch;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
  }
  .post-card-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    /* dashed separator above foot — perforation line */
    padding-top: 0.5rem;
    border-top: 1px dashed color-mix(in oklab, var(--rule) 80%, transparent);
    width: fit-content;
  }
  .post-card-rt::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--rule-strong, var(--rule));
  }
  /* Sibling deep-link to category — visually hidden, keyboard reachable. */
  .post-card-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .post-card-cat-link:focus-visible {
    width: auto;
    height: auto;
    clip: auto;
    top: 1.125rem;
    right: 0;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }
</style>
