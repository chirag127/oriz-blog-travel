---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — OVERLAY EXPEDITION STRIP (archetype: full-bleed hero + overlay nav).
 *
 * A thin transparent strip that floats OVER the full-bleed hero — no opaque
 * sticky masthead bar. It condenses to a solid mini-bar once the reader scrolls
 * past the hero (data-condensed toggled by an IntersectionObserver on #hero-end).
 *
 *   ╔══════════════════════════════════════════════════════════════════════╗
 *   ║  oriz/atlas   ROUTES · GUIDES · SERIES · FIELD   ⌘K  ⚙            ║  ← over hero
 *   ╚══════════════════════════════════════════════════════════════════════╝
 *
 * Nav renamed to the atlas vocabulary (Routes/Guides/Series/Field), not the
 * sibling LATEST/SERIES/TAGS/ABOUT. Left: z-strike wordmark. Right: ⌘K + gear.
 */
import Wordmark from '~/components/Wordmark.astro'

const path = Astro.url.pathname
const isHome = path === '/'
const nav = [
  { href: '/blog/', label: 'Routes', match: (p: string) => p.startsWith('/blog') },
  { href: '/categories/', label: 'Guides', match: (p: string) => p.startsWith('/categories') },
  { href: '/series/', label: 'Series', match: (p: string) => p.startsWith('/series') },
  { href: '/about/', label: 'Field', match: (p: string) => p.startsWith('/about') || p.startsWith('/now') },
]
---

<StatusBanner />
<header
  class:list={['expedition-strip', { 'is-over-hero': isHome }]}
  data-condensed={isHome ? 'false' : 'true'}
  transition:persist="site-header"
>
  <div class="strip-inner">
    <div class="brand">
      <Wordmark subtitle="atlas" size={19} href="/" />
    </div>
    <nav class="strip-nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="strip-tools">
      <div class="strip-search"><MultiSearch client:idle /></div>
      <div class="strip-controls"><HeaderControls client:idle /></div>
    </div>
  </div>
</header>

{isHome && (
  <script is:inline>
    {`(() => {
      const header = document.querySelector('.expedition-strip');
      const sentinel = document.getElementById('hero-end');
      if (!header || !sentinel || !('IntersectionObserver' in window)) {
        header && header.setAttribute('data-condensed', 'true');
        return;
      }
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          header.setAttribute('data-condensed', e.isIntersecting ? 'false' : 'true');
        }
      }, { rootMargin: '-56px 0px 0px 0px', threshold: 0 });
      io.observe(sentinel);
    })()`}
  </script>
)}

<style>
  .expedition-strip {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur-base, 200ms) var(--ease-out, ease),
      border-color var(--dur-base, 200ms) var(--ease-out, ease),
      backdrop-filter var(--dur-base, 200ms) ease;
  }

  /* Default (non-home, or condensed): solid map-panel bar. */
  .expedition-strip[data-condensed='true'] {
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom-color: var(--rule);
  }

  /* Over the hero: transparent floating strip, light-on-dark ink. */
  .expedition-strip.is-over-hero[data-condensed='false'] {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .expedition-strip.is-over-hero[data-condensed='false'] :global(.wordmark),
  .expedition-strip.is-over-hero[data-condensed='false'] .strip-nav a {
    color: #f2ede0;
  }
  .expedition-strip.is-over-hero[data-condensed='false'] :global(.wordmark-sep) {
    color: color-mix(in oklab, #f2ede0 55%, transparent);
  }

  .strip-inner {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    height: 56px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }

  /* Nav: aeronautical mono tabs, thin. */
  .strip-nav {
    display: none;
    gap: 1.5rem;
    margin-inline: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .strip-nav a {
    position: relative;
    padding-block: 0.5rem;
    color: var(--ink-mute);
    transition: color var(--dur-fast, 120ms) ease;
  }
  .strip-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.25rem;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast, 120ms) ease;
  }
  .strip-nav a:hover { color: var(--accent); }
  .strip-nav a:hover::after,
  .strip-nav a[aria-current='page']::after { transform: scaleX(1); }
  .strip-nav a[aria-current='page'] { color: var(--accent); }
  .is-over-hero[data-condensed='false'] .strip-nav a:hover,
  .is-over-hero[data-condensed='false'] .strip-nav a[aria-current='page'] {
    color: var(--sun);
  }
  .is-over-hero[data-condensed='false'] .strip-nav a::after { background: var(--sun); }

  .strip-tools {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .strip-search,
  .strip-controls { display: inline-flex; align-items: center; }

  @media (min-width: 768px) {
    .strip-nav { display: inline-flex; align-items: center; }
    .strip-tools { margin-left: 0; }
  }
</style>
